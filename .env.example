# Postgres (Neon). Get this from the Neon dashboard -> Connection string (pooled).
DATABASE_URL="postgresql://user:password@host.neon.tech/startup_central?sslmode=require"

# Site identity. Renaming the site is a one-line change here.
NEXT_PUBLIC_SITE_NAME="Startup Central"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Ingestion ---------------------------------------------------------------
# Shared secret. GitHub Actions sends this as `Authorization: Bearer <secret>`
# when triggering POST /api/ingest.
INGEST_SECRET=""

# Extraction provider. One of: regex | claude | generic
# `regex` is the zero-key default and works with no credentials at all.
EXTRACTOR="regex"

# Only needed when EXTRACTOR=claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Only needed when EXTRACTOR=generic (any OpenAI-compatible endpoint)
GENERIC_LLM_BASE_URL=""
GENERIC_LLM_API_KEY=""
GENERIC_LLM_MODEL=""

# Confidence at or above which an extracted event auto-publishes.
# Below this it lands in the admin review queue instead.
INGEST_AUTOPUBLISH_THRESHOLD="0.85"

# --- Admin auth (Auth.js, GitHub OAuth) --------------------------------------
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Only this GitHub login may access /admin.
ADMIN_GITHUB_LOGIN=""
