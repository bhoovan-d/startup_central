# --- Postgres (Supabase) ------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
#
# Two URLs, and the split matters:
#
#   DATABASE_URL  the TRANSACTION POOLER (port 6543). What the app uses.
#                 Serverless instances would otherwise each hold a real
#                 Postgres backend open, and Supabase's direct connection is
#                 IPv6-only, which most serverless platforms can't reach.
#
#   DIRECT_URL    the DIRECT connection (port 5432). Used only by
#                 `npm run db:migrate`. DDL through a transaction pooler is
#                 unreliable — drizzle-kit needs session state and advisory
#                 locks, and the pooler doesn't preserve either.
#
# Keep `?sslmode=require` on both; the pg driver reads SSL settings from it.
# On a plain Postgres instance, set DATABASE_URL only and omit DIRECT_URL.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Site identity. Renaming the site is a one-line change here.
NEXT_PUBLIC_SITE_NAME="Startup Central"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Podcast ------------------------------------------------------------------
# The subscribe row renders only the platforms set here. Leave a line blank
# until the show actually exists on that platform — a dead subscribe link is
# its own small lie.
NEXT_PUBLIC_PODCAST_YOUTUBE=""
NEXT_PUBLIC_PODCAST_SPOTIFY=""
NEXT_PUBLIC_PODCAST_APPLE=""

# --- Ingestion ----------------------------------------------------------------
# Shared secret. GitHub Actions sends this as `Authorization: Bearer <secret>`
# when triggering POST /api/ingest.
#
# While this is unset the endpoint returns 503 and runs nothing — it is off,
# not open. Generate one with:  openssl rand -hex 32
INGEST_SECRET=""

# Extraction provider. One of: regex | claude | generic
# `regex` is the zero-key default and works with no credentials at all.
# The others fall back to regex when their credentials are missing.
EXTRACTOR="regex"

# Only needed when EXTRACTOR=claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Only needed when EXTRACTOR=generic (any OpenAI-compatible endpoint)
GENERIC_LLM_BASE_URL=""
GENERIC_LLM_API_KEY=""
GENERIC_LLM_MODEL=""

# Confidence at or above which an extracted funding round auto-publishes.
# Below this it lands in the review queue instead (`npm run ingest:review`).
# Note the regex extractor caps its own confidence at 0.95, so at this
# threshold it auto-publishes only when every field matched.
INGEST_AUTOPUBLISH_THRESHOLD="0.85"

# --- Admin auth (not yet implemented) -----------------------------------------
# There is no /admin route today. Review happens through the CLI:
#
#   npm run ingest:review
#
# which needs no auth surface because it runs on your machine against
# DATABASE_URL. These variables are kept as the shape the future Auth.js
# route will take; nothing reads them yet.
# AUTH_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# ADMIN_GITHUB_LOGIN=""
